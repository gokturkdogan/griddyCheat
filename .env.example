# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary klasörü (varsayılan: griddycheats)
CLOUDINARY_FOLDER=griddycheats

# Transfermarkt seed gecikmesi (ms, varsayılan 1200)
# TRANSFERMARKT_DELAY_MS=1200
